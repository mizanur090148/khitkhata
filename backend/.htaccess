<IfModule mod_rewrite.c>
    RewriteEngine On

    # Deny direct web access to sensitive files and directories
    RewriteRule ^(\.env|\.git|artisan|composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml) - [F,L,NC]
    RewriteRule ^(app|bootstrap|config|database|storage|tests|vendor)(/.*)?$ - [F,L,NC]

    # Rewrite all requests to the public directory
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
