APP_NAME="KnitKhata (Silposetu)"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.knitkhata.com
FRONTEND_URL=https://knitkhata.com
ALLOWED_ORIGINS=https://knitkhata.com,https://www.knitkhata.com,http://knitkhata.com

APP_LOCALE=bn
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# cPanel MySQL Database Credentials (Created in cPanel MySQL Database Wizard)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cpaneluser_silposetu
DB_USERNAME=cpaneluser_dbuser
DB_PASSWORD=YourStrongDatabasePassword

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

SANCTUM_STATEFUL_DOMAINS=knitkhata.com,www.knitkhata.com,api.knitkhata.com


